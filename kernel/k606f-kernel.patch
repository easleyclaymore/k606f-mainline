+&i2c5 {
+	/*
+	 * 原厂 FDT：qupv3_se5_i2c(994000) 是 status="disabled"，且它的默认引脚是 gpio12/13。
+	 * 本机 gpio12 是 eDP 桥的 mipi-to-edp-en，所以这条总线必须关掉，否则桥拿不到这根线。
+	 * 下面 4 个功放节点是从别的板子带过来的，本机原厂 FDT 里没有 cs35l45；
+	 * 音频属于 v0.2，等音频阶段再按原厂证据重建（技术债 #23）。
+	 */
+	status = "disabled";
+	clock-frequency = <400000>;
+
+	// SPK1-cs35l45
+	// SPK1_fast_switch_music.txt SPK1_fast_switch_ring.txt SPK1_fast_switch_voice.txt
+	cs35l45_spk1: speaker-amp@30 {
+		compatible = "cirrus,cs35l45";
+		reg = <0x30>;
+		vdd-a-supply = <&vreg_s4a_1p8>;
+		vdd-batt-supply = <&audio4_1p8_supply>;
