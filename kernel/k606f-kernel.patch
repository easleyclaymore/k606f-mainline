index 000000000..6f3ab92d6
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8250-lenovo-k606f.dts
@@ -0,0 +1,1767 @@
+// SPDX-License-Identifier: GPL-2.0
