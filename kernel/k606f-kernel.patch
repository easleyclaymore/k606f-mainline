+&i2c1 {
+	status = "okay";
+	clock-frequency = <100000>;	/* 桥（原厂 qcom,clk-freq-out = 100 kHz）与笔充电器共用这条总线 */
+	/* Pen Charging NXP CTN730 Qi charger @ 28 */
+
+	edp_mux: bridge@33 {
+		compatible = "lenovo,psa8331-edp-mux";
+		reg = <0x33>;		/* 原厂 DT 写 0x66，是 8 bit 形式 */
+		status = "okay";
+
+		vdd-1p2-supply = <&vreg_l3c_0p8>;
+		vdd-1p5-supply = <&vreg_l7a_1p5>;
+		vdd-1p8-supply = <&vreg_l15a_1p8>;
+		vdd-3p3-supply = <&vreg_l11c_3p3>;
+
+		/* 原厂 FDT：clocks = <rpmhclk 4>，clock-names = "bb_clk2"。
+		 * rpmh.h 里编号 4 = RPMH_LN_BB_CLK3（clk 名 "lnbclka3"）。
+		 * 之前抄成 RPMH_LN_BB_CLK2（编号 2，"lnbclka2"）是错的 ——
+		 * 桥的 DP PLL 靠这个参考时钟锁相，给错时钟就锁不上（B29 定位，0x0A 卡 0x02）。 */
+		clocks = <&rpmhcc RPMH_LN_BB_CLK3>;
+		clock-names = "refclk";
+
+		lcd-bob-en-gpios = <&tlmm 71 GPIO_ACTIVE_HIGH>;
+		lcd-3v3-en-gpios = <&tlmm 101 GPIO_ACTIVE_HIGH>;
+		edp-mux-pwr-en-gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+		mipi-to-edp-en-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+		boost-bypass-en-gpios = <&tlmm 46 GPIO_ACTIVE_HIGH>;
+		boost-vsel-en-gpios = <&tlmm 48 GPIO_ACTIVE_HIGH>;
+		boost-nbyp-en-gpios = <&tlmm 49 GPIO_ACTIVE_HIGH>;
+		bl-pwr-en-gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>;
+		bl-en-gpios = <&tlmm 102 GPIO_ACTIVE_HIGH>;
+
+		/* 厂商代码里这几根是低电平有效 */
+		panel-gpio-mux-en-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+		io-mux-en-gpios = <&tlmm 67 GPIO_ACTIVE_LOW>;
+		i2s-mux-en-gpios = <&tlmm 14 GPIO_ACTIVE_LOW>;
+		io-mux-select-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;
+		edp-aux-port-sel-gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
+		i2s-mux-select-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
+
+		/* 读到 0 表示桥上电完成，所以按原始电平取（高有效） */
+		pwr-status-gpios = <&tlmm 72 GPIO_ACTIVE_HIGH>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				edp_mux_in: endpoint {
+					remote-endpoint = <&mdss_dsi0_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				edp_mux_out: endpoint {
+					remote-endpoint = <&panel_in_0>;
+				};
+			};
+		};
+	};
+};
