+		pinctrl-names = "default";
+		reset-gpios = <&tlmm 127 GPIO_ACTIVE_HIGH>;
+		cirrus,asp-sdout-hiz-ctrl = <(CS35L45_ASP_TX_HIZ_UNUSED | CS35L45_ASP_TX_HIZ_DISABLED)>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "SPK1"; //SPK1-cs35l45
+		cirrus,gpio-ctrl2 {
+			gpio-ctrl = <0x2>;
+		};
+	};
+
+	cs35l45_spk2: speaker-amp@31 {
+		compatible = "cirrus,cs35l45";
+		reg = <0x31>;
+		vdd-a-supply = <&vreg_s4a_1p8>;
+		vdd-batt-supply = <&audio4_1p8_supply>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <51 IRQ_TYPE_LEVEL_LOW>;
+		// interrupts-extended = <&tlmm 51 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 127 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&cs35l45_2_irq_default &cs35l45_1v8_enable>;
+		pinctrl-names = "default";
+		cirrus,asp-sdout-hiz-ctrl = <(CS35L45_ASP_TX_HIZ_UNUSED | CS35L45_ASP_TX_HIZ_DISABLED)>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "SPK2";//SPK2-cs35l45
+		cirrus,gpio-ctrl2 {
+			gpio-ctrl = <0x2>;
+		};
+	};
+
+	cs35l41_spk3: speaker-amp@36 {
+		compatible = "cirrus,cs35l45";
+		reg = <0x36>;
+		vdd-a-supply = <&vreg_s4a_1p8>;
+		vdd-batt-supply = <&audio4_1p8_supply>;
+		pinctrl-0 = <&cs35l45_3_irq_default &cs35l45_1v8_enable>;
+		pinctrl-names = "default";
+		interrupts-extended = <&tlmm 100 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 127 GPIO_ACTIVE_HIGH>;
+		cirrus,asp-sdout-hiz-ctrl = <(CS35L45_ASP_TX_HIZ_UNUSED | CS35L45_ASP_TX_HIZ_DISABLED)>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "SPK3";//SPK3-cs35l45
+		cirrus,gpio-ctrl2 {
+			gpio-ctrl = <0x2>;
+		};
+	};
+
+	cs35l41_spk4: speaker-amp@37 {
+		compatible = "cirrus,cs35l45";
+		reg = <0x37>;
+		vdd-a-supply = <&vreg_s4a_1p8>;
+		vdd-batt-supply = <&audio4_1p8_supply>;
+		pinctrl-0 = <&cs35l45_4_irq_default &cs35l45_1v8_enable>;
+		pinctrl-names = "default";
+		interrupts-extended = <&tlmm 93 IRQ_TYPE_LEVEL_LOW>;
