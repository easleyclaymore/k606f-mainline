+		cirrus,asp-sdout-hiz-ctrl = <(CS35L45_ASP_TX_HIZ_UNUSED | CS35L45_ASP_TX_HIZ_DISABLED)>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "SPK4";//SPK4-cs35l45
+		cirrus,gpio-ctrl2 {
+			gpio-ctrl = <0x2>;
+		};
+	};
+	/* Cirrus CS35L45 (Speaker 1) @ 30 */
+	/* Cirrus CS35L45 (Speaker 2) @ 31 */
+	/* Cirrus CS35L45 (Speaker 3) @ 36 */
